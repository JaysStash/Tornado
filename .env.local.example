# Copy this file to .env.local and fill in real values from your Supabase
# and Resend dashboards. .env.local is gitignored - never commit real keys.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase project settings -> API -> service_role key.
# SERVER-ONLY - never prefix this with NEXT_PUBLIC_, never expose it to
# the browser. Used only by app/api/ route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) - free tier, no credit card, 100 emails/day.
# Used to notify you when a submission needs moderation review.
RESEND_API_KEY=your-resend-api-key
ADMIN_EMAIL=you@example.com
